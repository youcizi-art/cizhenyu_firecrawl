{
  "protocolVersion": 1,
  "id": "firecrawl",
  "name": "Firecrawl",
  "category": "crawl",
  "tier": "recommended",
  "description": "Web scrape / crawl / map / search",
  "source": {
    "github": "https://github.com/youcizi-art/cizhenyu_firecrawl",
    "defaultRef": "master"
  },
  "install": {
    "runtime": "python",
    "steps": [],
    "readyCheck": [
      "server.py"
    ]
  },
  "credentials": {
    "key": "firecrawl",
    "fields": [
      {
        "type": "password",
        "name": "apiKey",
        "label": "API Key",
        "required": true,
        "tip": "Create or copy an API Key in the Firecrawl console",
        "link": {
          "label": "Firecrawl API Keys",
          "url": "https://www.firecrawl.dev/app"
        }
      }
    ],
    "sidecar": "firecrawl.json"
  },
  "env": [
    {
      "name": "FIRECRAWL_API_KEY",
      "fromCredential": "apiKey"
    },
    {
      "name": "CIZHENYU_AUTH_DIR",
      "from": "credentialsDir"
    }
  ],
  "mcp": {
    "transport": "stdio",
    "command": "python",
    "args": [
      "server.py"
    ],
    "cwd": "."
  },
  "guides": {
    "setup": "guides/setup.md",
    "setupByLocale": {
      "zh-CN": "guides/setup.md",
      "zh": "guides/setup.md",
      "en": "guides/setup.en.md",
      "en-US": "guides/setup.en.md"
    }
  },
  "health": {
    "requireCredentials": true,
    "requireReadyFiles": [
      "server.py"
    ]
  },
  "actions": [],
  "defaultLocale": "en",
  "i18n": {
    "zh-CN": {
      "description": "网页抓取 / crawl / map / search",
      "fields": {
        "apiKey": {
          "tip": "在 Firecrawl 控制台创建或复制 API Key",
          "linkLabel": "Firecrawl API Keys"
        }
      }
    }
  }
}
